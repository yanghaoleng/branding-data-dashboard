[Unit]
Description=Branding owned-media metrics API and scheduler
After=network.target
[Service]
Type=simple
User=branding-data
Group=branding-data
EnvironmentFile=/etc/branding-database.env
WorkingDirectory=/opt/branding-database/current/server
ExecStart=/usr/bin/python3 /opt/branding-database/current/server/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/branding-database
UMask=0077
[Install]
WantedBy=multi-user.target
